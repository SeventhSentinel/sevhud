AddOptionMenu "OptionsMenu" before "reset2defaults"
{
	StaticText "$NASHBAR_VERSION"
	SubMenu "$OPTMNU_NASHBAR", "NashBarOptionMenu"
	StaticText ""
}

AddOptionMenu "OptionsMenuSimple" before "reset2defaults"
{
	StaticText "$NASHBAR_VERSION"
	SubMenu "$OPTMNU_NASHBAR", "NashBarOptionMenu"
	StaticText ""
}

OptionMenu "NashBarOptionMenu"
{
	Title "$OPTMNU_NASHBAR"
	Position -32
	Option "$OPTMNU_NASHBAR_HP_BAR", "nashbar_hpbar", "OnOff"
}
